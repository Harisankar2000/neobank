# Every value below has a working default for local development (see apps/api/src/config/env.ts),
# so this file is optional locally. Copy it to .env only to change something.

NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info

DATABASE_URL=postgresql://neobank:neobank@localhost:5435/neobank
REDIS_URL=redis://localhost:6382
KAFKA_BROKERS=localhost:29093
KAFKA_TOPIC=bank.events

# Production refuses to start while these still begin with "dev-".
JWT_SECRET=dev-only-jwt-secret-change-me
ADMIN_API_KEY=dev-admin-key

CORS_ORIGINS=http://localhost:5175
RATE_LIMIT_MAX=300
OUTBOX_POLL_INTERVAL_MS=500
